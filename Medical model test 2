    };

    let userAnswers = {};
    let timerId = null;
    let isReviewMode = false;
    let isQMinimized = false;

    function renderQuestions() {
        const qBox = document.getElementById('questionBox');
        qBox.innerHTML = questionsData.map((item) => `
            <div class="q-card">
                <div class="q-title">${item.q}</div>
                <div class="q-options-grid">
                    ${item.opts.map(opt => `<div>${opt}</div>`).join('')}
                </div>
            </div>
        `).join('');
    }

    function toggleQuestionPanel() {
        const qBox = document.getElementById('questionBox');
        const btn = document.getElementById('toggleQBtn');
        isQMinimized = !isQMinimized;
        if (isQMinimized) {
            qBox.classList.add('hidden');
            btn.textContent = '➕ Expand Questions';
        } else {
            qBox.classList.remove('hidden');
            btn.textContent = '➖ Minimise Questions';
        }
    }

    function renderStudentOmr() {
        let html = '';
        for (let i = 1; i <= TOTAL_QUESTIONS; i++) {
            const key = `Q_${i}`;
            const selectedOpt = userAnswers[key];
            
            html += `
            <div class="omr-row" id="row-${key}">
                <span class="q-num">${i}.</span>
                <div class="options">
                    ${['A', 'B', 'C', 'D'].map(opt => {
                        const isSel = selectedOpt === opt;
                        const isDisabled = !!selectedOpt;
                        return `
                        <div class="bubble ${isSel ? 'selected' : ''} ${isDisabled ? 'disabled' : ''}" 
                             onclick="handleBubbleClick('${key}', '${opt}', this)">
                            ${opt}
                        </div>`;
                    }).join('')}
                </div>
            </div>`;
        }
        document.getElementById('studentOmrGrid').innerHTML = html;
    }

    function handleBubbleClick(key, option, element) {
        if (userAnswers[key] || isReviewMode) return;
        userAnswers[key] = option;
        element.classList.add('selected');

        const parent = element.parentElement;
        Array.from(parent.children).forEach(c => c.classList.add('disabled'));

        localStorage.setItem('med_user_answers', JSON.stringify(userAnswers));
    }

    function startStudentExam() {
        document.getElementById('instructionPanel').classList.add('hidden');
        document.getElementById('examPanel').classList.remove('hidden');
        document.getElementById('timerContainer').classList.remove('hidden');

        renderQuestions();
        
        const savedAnswers = localStorage.getItem('med_user_answers');
        if (savedAnswers) {
            try { userAnswers = JSON.parse(savedAnswers); } catch(e) { userAnswers = {}; }
        } else {
            userAnswers = {};
        }

        isReviewMode = false;
        renderStudentOmr();
        startTimer(EXAM_MINUTES * 60);
    }

    function startTimer(seconds) {
        clearInterval(timerId);
        const timerDisp = document.getElementById('timer');

        timerId = setInterval(() => {
            let m = Math.floor(seconds / 60);
            let s = seconds % 60;

            m = m < 10 ? '0' + m : m;
            s = s < 10 ? '0' + s : s;

            timerDisp.textContent = `${m}:${s}`;

            if (--seconds < 0) {
                clearInterval(timerId);
                alert('৬০ মিনিট সময় শেষ! উত্তরপত্র জমা নেওয়া হলো।');
                submitExam(true);
            }
        }, 1000);
    }

    function submitExam(autoSubmit = false) {
        if (!autoSubmit && !confirm("আপনি কি নিশ্চিত যে উত্তরপত্র জমা দিতে চান?")) return;

        clearInterval(timerId);
        localStorage.removeItem('med_user_answers');
        document.getElementById('timerContainer').classList.add('hidden');
        document.getElementById('examPanel').classList.add('hidden');
        document.getElementById('resultPanel').classList.remove('hidden');

        calculateResults();
    }

    function calculateResults() {
        let correct = 0;
        let wrong = 0;
        let skipped = 0;

        for (let i = 1; i <= TOTAL_QUESTIONS; i++) {
            const key = `Q_${i}`;
            const user = userAnswers[key];
            const right = correctAnswers[key];

            let isCorrect = false;
            if (Array.isArray(right)) {
                isCorrect = right.includes(user);
            } else {
                isCorrect = (right === user);
            }

            if (!user) {
                skipped++;
            } else if (isCorrect) {
                correct++;
            } else {
                wrong++;
            }
        }

        const totalMark = (correct * 1.0) - (wrong * 0.25);
        const isPassed = totalMark >= PASS_MARK;

        document.getElementById('scoreDisplay').textContent = `${totalMark.toFixed(2)} / ${TOTAL_QUESTIONS}`;
        
        const statusElem = document.getElementById('passFailStatus');
        if (isPassed) {
            statusElem.textContent = '🎉 অভিনন্দন! আপনি পাস করেছেন।';
            statusElem.style.color = 'var(--correct)';
        } else {
            statusElem.textContent = '❌ দুঃখিত! আপনি ফেল করেছেন।';
            statusElem.style.color = 'var(--wrong)';
        }

        document.getElementById('correctCnt').textContent = correct;
        document.getElementById('wrongCnt').textContent = wrong;
        document.getElementById('skippedCnt').textContent = skipped;
    }

    function reviewExam() {
        isReviewMode = true;
        document.getElementById('resultPanel').classList.add('hidden');
        document.getElementById('examPanel').classList.remove('hidden');

        for (let i = 1; i <= TOTAL_QUESTIONS; i++) {
            const key = `Q_${i}`;
            const row = document.getElementById(`row-${key}`);
            if (!row) continue;

            const bubbles = row.querySelectorAll('.bubble');
            const user = userAnswers[key];
            const right = correctAnswers[key];

            bubbles.forEach(b => {
                const opt = b.textContent.trim();
                b.classList.remove('selected', 'disabled');

                let isRightOpt = false;
                if (Array.isArray(right)) {
                    isRightOpt = right.includes(opt);
                } else {
                    isRightOpt = (opt === right);
                }

                if (isRightOpt) {
                    b.classList.add('correct-ans');
                }
                if (user && opt === user && !isRightOpt) {
                    b.classList.add('wrong-ans');
                }
            });
        }
    }

    function retakeExam() {
        localStorage.removeItem('med_user_answers');
        userAnswers = {};
        document.getElementById('resultPanel').classList.add('hidden');
        startStudentExam();
    }
</script>

